!/frontend/public/**/*.jpg
!/frontend/public/**/*.jpeg
!/frontend/public/**/*.webp
!/frontend/public/**/*.gif
!/frontend/src/assets/**/*.png
!/frontend/src/assets/**/*.jpg
!/frontend/src/assets/**/*.jpeg
!/frontend/src/assets/**/*.webp
!/frontend/src/assets/**/*.gif

