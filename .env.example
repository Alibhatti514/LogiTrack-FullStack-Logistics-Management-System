# OPTIONAL custom backend configuration template. No real credentials belong here.
# The normal scripts/run-mac.sh path generates root .env securely when it is absent.
# If using this template instead, fill every required value privately before startup.
# Never overwrite an existing .env. Empty Jwt__Key deliberately fails validation.

# Required: generate your own cryptographically random secret, at least 32 bytes.
Jwt__Key=

# Optional bootstrap Manager provisioning: set both values for Manager write access.
# Password policy: at least 12 characters plus uppercase, lowercase, digit and symbol.
Bootstrap__ManagerEmail=
Bootstrap__ManagerPassword=

# Optional isolated SQLite target; use an absolute path and keep it out of Git.
# ConnectionStrings__DefaultConnection="Data Source=/absolute/private/test.db"
